<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RedBamboo.AppHost</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>RedBamboo.AppHost</PackageId>
    <Version>0.1.0</Version>
    <Description>Shared infrastructure for RedBamboo apps — tunnel, auth, discovery, tray</Description>
    <UseWPF Condition="'$(TargetFramework)' == 'net9.0-windows'">true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RedLeaf.App.Tests" />
    <InternalsVisibleTo Include="RedBamboo.AppHost.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Microsoft.Data.Sqlite 9.0.0 depends on SQLitePCLRaw.bundle_e_sqlite3 2.1.10 (SQLite 3.46.1,
         GHSA-2m69-gcr7-jv3q / CVE-2025-6965, fixed in SQLite 3.50.2). 2.1.12 carries SQLite 3.53.3, so
         every consumer of AppHost gets the fixed native library. Drop it once Microsoft.Data.Sqlite
         depends on a fixed bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.7.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
