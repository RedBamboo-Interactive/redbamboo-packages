{
  "name": "@redbamboo/chat",
  "version": "0.4.6",
  "description": "Streaming chat UI with adapter-based backend — for CodeRed, Nova, and beyond",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/chat.css",
    "./event-parts": {
      "types": "./src/lib/event-parts.ts",
      "default": "./src/lib/event-parts.ts"
    },
    "./conversation-read-state": {
      "types": "./src/lib/conversation-read-state.ts",
      "default": "./src/lib/conversation-read-state.ts"
    },
    "./background-work": {
      "types": "./src/lib/background-work.ts",
      "default": "./src/lib/background-work.ts"
    },
    "./tool-semantics": {
      "types": "./src/lib/tool-semantics.ts",
      "default": "./src/lib/tool-semantics.ts"
    },
    "./chat-status": {
      "types": "./src/lib/chat-status.ts",
      "default": "./src/lib/chat-status.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:queue-ui": "node tests/queue-presentation/run.cjs",
    "test:part-navigation": "node tests/part-navigation/run.cjs",
    "test:background-work": "node tests/background-work/run.cjs",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@redbamboo/ui": "workspace:*",
    "@redbamboo/utility": "workspace:*",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
